---
/**
 * Google Ads 全站埋点头部 (单一数据源)
 *
 * gtag.js 脚本全页只加载一次 (loader id = 第一个 AW 号), 其余 AW 号通过
 * `gtag('config', id)` 追加 —— 多个 Google Ads 账号共用同一个 gtag.js 与
 * dataLayer, 不会冲突。重复加载两次 gtag.js 才是冲突根因。
 *
 * ⚠️ config 必须输出为逐条字面量 `gtag('config','AW-xxx');`, 不能用 forEach 循环展开:
 * Google Ads 后台「测试/验证代码」是直接搜页面 HTML 里的 config 字面量,
 * 循环写法线上照样上报 (Tag Assistant 可验证), 但后台校验会报「未检测到 Google 代码」。
 * 账号清单仍以 src/config/tracking.ts 为唯一数据源, 这里只负责展开成字面量。
 *
 * 使用位置:
 *   - src/layouts/Layout.astro (所有走 Layout 的页面, 含全站博客页)
 *   - 独立 Astro 页面 (不走 Layout): apple-watch / fitness / mary-jane-sneakers 等
 *   - 裸 HTML 页面由 scripts/inject-ads-snippet.mjs 生成同样结构的片段
 *
 * ⚠️ 每个页面只能放一次。
 */
import { AD_TAGS, GTAG_LOADER_ID, PAGE_VIEW_CONVERSIONS, GTM_ID } from '~/config/tracking';

const configLines = AD_TAGS.map((t) => `gtag('config', '${t.id}');`).join('\n');
const conversionLines = PAGE_VIEW_CONVERSIONS.map((c) => `gtag('event', 'conversion', {'send_to': '${c.sendTo}'});`)
  .join('\n');

const inlineScript = [
  'window.dataLayer = window.dataLayer || [];',
  'function gtag(){dataLayer.push(arguments);}',
  "gtag('js', new Date());",
  configLines,
  conversionLines,
]
  .filter(Boolean)
  .join('\n');
---
<!-- Google tag (gtag.js) -->
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_LOADER_ID}`}></script>
<script is:inline set:html={inlineScript}></script>

<!-- Google Tag Manager (GTM) —— 与 gtag.js 并存, 共用 dataLayer, 各自只加载一次 -->
<script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`}></script>
<script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());`}></script>
