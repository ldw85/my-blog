---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// AliExpress 联盟跟踪链接 (YeahPromos → BlueAff → aliexpress.com)
// 格式: track=<ID>&url=<目标页>, url 留空时默认跳 AliExpress 首页
const AFFILIATE_URL =
  'https://yeahpromos.com/index/index/openurl?track=216f339884691499&url=';

const metadata = {
  title: 'AliExpress 11.11 Shopping Event - TechReviews',
  description:
    'Shop the AliExpress 11.11 shopping event: tech, home, fashion and gift finds with free shipping on eligible Choice orders, buyer protection and seasonal offers.',
};
---

<style is:global>
  /* Override intersection animations for Hero section - show immediately */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }
  .ali-hero {
    background: linear-gradient(135deg, #ff8a3d 0%, #ff6a00 45%, #e62e04 100%);
  }
  .ali-btn {
    background: #ff6a00 !important;
    border: 2px solid #ff6a00 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .ali-btn:hover {
    background: #e62e04 !important;
    border-color: #e62e04 !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(230, 46, 4, 0.4) !important;
  }
  .ali-outline-btn {
    background: transparent !important;
    border: 2px solid rgba(255, 255, 255, 0.7) !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .ali-outline-btn:hover {
    background: rgba(255, 255, 255, 0.14) !important;
    transform: translateY(-2px);
  }
  .ali-brand-mark {
    background: #ffffff;
    color: #ff6a00;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ali-trust-badge {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.32);
  }
  .ali-category:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(230, 46, 4, 0.18);
  }
  .ali-category-link {
    color: #e62e04;
    letter-spacing: 0.04em;
  }
</style>

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section ali-hero">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-14 max-w-5xl mx-auto">
          <p class="text-base text-white font-bold tracking-widest uppercase mb-4">
            The 11.11 Shopping Event · Nov 1–18
          </p>
          <h1
            class="text-5xl md:text-7xl font-bold leading-tighter tracking-tighter mb-6 font-heading text-white"
          >
            Good finds. <em class="not-italic text-[#ffe08a]">Better prices.</em>
            <br />Only on <span class="ali-brand-mark px-3 py-1 rounded-xl inline-block">AliExpress</span>
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
              Explore seasonal offers across tech, home, fashion and gift-worthy finds — millions of
              products in one global marketplace.
            </p>

            <!-- Promo Badge -->
            <div
              class="inline-block bg-white text-[#e62e04] px-6 py-3 rounded-full font-bold text-lg mb-8"
            >
              11.11 Seasonal Deals · Through Nov 18, 2026
            </div>

            <!-- Trust Badges -->
            <div class="flex flex-wrap justify-center gap-4 mb-8">
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                📦 Free shipping on eligible Choice orders
              </div>
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                🛡️ Buyer protection
              </div>
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                ↩️ Free returns on eligible items
              </div>
            </div>

            <div class="max-w-xl m-auto flex flex-col sm:flex-row justify-center gap-4">
              <a
                href={AFFILIATE_URL}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="btn btn-primary sm:mb-0 ali-btn"
              >
                Shop AliExpress Now ↗
              </a>
              <a href="#categories" class="btn ali-outline-btn">Browse categories</a>
            </div>
            <p class="text-white/70 text-xs mt-4">
              Offers and eligibility vary by item. Shopping links use affiliate tracking.
            </p>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="relative m-auto max-w-5xl">
          <img
            src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80"
            alt="Seasonal online shopping deals on AliExpress"
            class="mx-auto rounded-lg w-full shadow-2xl"
            loading="eager"
            width="1024"
            height="576"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Shopping Benefits -->
  <section class="py-14 not-prose" aria-label="Shopping benefits">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">📦</div>
          <b class="block text-sm">Free shipping</b>
          <span class="block text-xs text-gray-500 mt-1">On eligible Choice orders</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">🚚</div>
          <b class="block text-sm">Fast delivery</b>
          <span class="block text-xs text-gray-500 mt-1">On qualifying items</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">↩️</div>
          <b class="block text-sm">Free returns</b>
          <span class="block text-xs text-gray-500 mt-1">Eligible items, terms apply</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">✦</div>
          <b class="block text-sm">New lower prices</b>
          <span class="block text-xs text-gray-500 mt-1">Selected seasonal offers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Shop by Category -->
  <section id="categories" class="py-14 not-prose scroll-mt-24" aria-labelledby="categories-title">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="text-sm font-bold uppercase tracking-widest text-[#e62e04] mb-3">
          Find your kind of deal
        </div>
        <h2 id="categories-title" class="text-4xl md:text-5xl font-bold tracking-tighter mb-4">
          Explore by interest
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Start with a category, then browse current offers and check item details, delivery options
          and return terms.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&w=700&q=75"
            alt="Technology and electronics accessories on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Tech &amp; Electronics</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Everyday tech, devices and useful accessories.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=700&q=75"
            alt="Kitchen and home essentials on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Home &amp; Kitchen</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Practical upgrades for cooking, storage and home.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=75"
            alt="Fashion and accessories shopping on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Fashion &amp; Accessories</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Fresh looks, useful extras and everyday style.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=700&q=75"
            alt="Wrapped gifts and seasonal finds on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Gifts &amp; Seasonal Finds</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Gift inspiration for the holidays and beyond.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Shopping Tips -->
  <section class="py-16 not-prose bg-gradient-to-br from-orange-50 to-amber-50" aria-labelledby="tips-title">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <div class="text-sm font-bold uppercase tracking-widest text-[#a66e0d] mb-3">
          A smarter way to browse
        </div>
        <h2 id="tips-title" class="text-4xl font-bold tracking-tighter mb-4">
          A good deal is more than a low price.
        </h2>
        <p class="text-gray-600 mb-6">
          Before checking out on AliExpress, take a moment to compare the item details and make sure
          the offer fits what you need.
        </p>
        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="btn ali-btn"
        >
          Browse current offers →
        </a>
      </div>
      <div class="grid gap-3">
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            01
          </div>
          <div>
            <b class="block text-sm">Check the full price</b>
            <span class="block text-xs text-gray-500 mt-1">
              Review the current item price, shipping costs and any coupon conditions.
            </span>
          </div>
        </div>
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            02
          </div>
          <div>
            <b class="block text-sm">Review delivery estimates</b>
            <span class="block text-xs text-gray-500 mt-1">
              Delivery options and arrival dates can differ by item and destination.
            </span>
          </div>
        </div>
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            03
          </div>
          <div>
            <b class="block text-sm">Read return conditions</b>
            <span class="block text-xs text-gray-500 mt-1">
              Confirm whether the selected item qualifies for free returns and the applicable window.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CallToAction
    title="Ready to explore the AliExpress 11.11 sale?"
    subtitle="Browse a broad marketplace of products and discover current seasonal offers. Prices, availability and benefits are set by the retailer and may change."
    actions={[
      {
        variant: 'primary',
        text: 'Go to AliExpress ↗',
        href: AFFILIATE_URL,
        target: '_blank',
        rel: 'noopener noreferrer sponsored',
      },
    ]}
  />

  <!-- Affiliate Disclosure -->
  <section class="not-prose pb-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="border border-gray-200 rounded-xl bg-white p-5 text-xs text-gray-500 leading-relaxed">
        <b>Affiliate disclosure:</b> This is an independent shopping guide. We may earn a commission
        if you make a purchase through links on this page, at no additional cost to you. We are not
        the retailer and are not an official website or representative of AliExpress. Product prices,
        promotions, shipping, delivery and return eligibility are controlled by the retailer and may
        vary. Please review the retailer's current terms before purchasing.
      </div>
    </div>
  </section>

  <!-- Exit-intent 邮箱订阅弹窗: 离开页面时展示 11.11 折扣信息并收集邮箱 (FormSubmit) -->
  <div
    id="dealModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
  >
    <div class="relative w-full max-w-md bg-white rounded-3xl p-7 shadow-2xl">
      <button
        id="modalClose"
        type="button"
        aria-label="Close"
        class="absolute right-4 top-4 w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 text-xl leading-none"
      >
        ×
      </button>
      <span class="inline-block bg-[#fff0c9] text-[#8a560b] rounded-full px-3 py-1.5 text-[11px] font-bold tracking-widest uppercase">
        🔥 11.11 Exclusive Offer
      </span>
      <h3 id="modalTitle" class="text-2xl font-bold tracking-tight mt-4 pr-8">
        Wait — don't miss your <span class="text-[#e62e04]">11.11 discount</span>!
      </h3>
      <div class="bg-gradient-to-r from-[#ff8a3d] to-[#e62e04] text-white rounded-2xl px-4 py-3 mt-4 text-sm font-bold">
        🎁 Extra coupon codes + seasonal savings inside — selected items up to 70% off (Nov 1–18).
      </div>
      <p class="text-sm text-gray-500 mt-4 mb-4">
        Leave your email and we'll send you AliExpress discount codes and deal alerts. No purchase
        needed — unsubscribe anytime.
      </p>
      <form id="emailForm">
        <div class="flex flex-col gap-2">
          <input
            type="email"
            name="email"
            id="email"
            placeholder="Your email address"
            autocomplete="email"
            required
            aria-label="Your email address"
            class="border border-gray-300 rounded-xl px-3.5 py-3 text-sm outline-none focus:border-[#ff6a00] focus:ring-2 focus:ring-[#ff6a00]/25"
          />
          <button
            id="submitBtn"
            type="submit"
            class="bg-[#ff6a00] hover:bg-[#e62e04] text-white font-bold rounded-xl py-3 text-sm transition-colors"
          >
            Send me the deals
          </button>
        </div>
        <label class="flex items-start gap-2 text-[11px] text-gray-500 mt-3">
          <input type="checkbox" id="consent" required class="mt-0.5 accent-[#ff6a00]" />
          <span>
            I agree to receive occasional shopping and promotion emails. I can withdraw my consent
            by replying "unsubscribe" or contacting the site operator.
          </span>
        </label>
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] w-px h-px"
        />
        <p class="text-[10px] text-gray-400 mt-2">
          Your email is sent to the site operator through FormSubmit. See our
          <a href="/privacy" target="_blank" rel="noopener" class="underline">privacy policy</a>.
        </p>
        <p id="formError" role="alert" class="hidden text-[11px] text-red-600 mt-2"></p>
      </form>
      <div id="formSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 rounded-xl p-3 text-sm mt-4">
        🎉 Thanks — you're on the list! Watch your inbox for 11.11 discount codes.
      </div>
      <a
        id="continueLink"
        href={AFFILIATE_URL}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block text-center mt-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition-colors"
      >
        No thanks — continue to AliExpress →
      </a>
    </div>
  </div>

  <!-- 移动端底部订阅提示 -->
  <div
    id="mobileNudge"
    class="hidden fixed z-40 bottom-3 left-3 right-3 bg-[#171a1f] text-white rounded-2xl px-4 py-3 shadow-2xl items-center justify-between gap-3 text-sm"
    role="status"
    aria-live="polite"
  >
    <span>🎁 Get 11.11 discount codes by email</span>
    <button id="nudgeOpen" type="button" class="bg-[#ff6a00] text-white font-bold rounded-full px-3.5 py-2 text-xs whitespace-nowrap">
      Get deals
    </button>
    <button id="nudgeClose" type="button" aria-label="Dismiss" class="text-white/70 px-1 text-lg leading-none">
      ×
    </button>
  </div>

  <script>
    // 退出弹窗逻辑 (改写自原版 index.html): 桌面端鼠标离开视口顶部触发, 移动端用非阻断式底栏;
    // 首次点击联盟链接也先弹窗(可跳过); localStorage 记录 snooze/已订阅状态
    (function () {
      'use strict';
      const AFFILIATE_URL = 'https://yeahpromos.com/index/index/openurl?track=216f339884691499&url=';
      // FormSubmit 端点链: 随机串主端点 (官方建议, 隐藏收件邮箱防爬虫收割) + 邮箱兑底端点;
      // 随机串端点首次使用需点击邮件激活 (按域名绑定), 激活前由兑底端点保证提交成功
      const FORM_ENDPOINTS = [
        'https://formsubmit.co/ajax/b56e265310430d01940ba1176e9bacde',
        'https://formsubmit.co/ajax/ldwldw85@outlook.com',
      ];
      const SNOOZE_KEY = 'aliexpress_1111_modal_snooze_v1';
      const SUBMITTED_KEY = 'aliexpress_email_submitted';

      const modal = document.getElementById('dealModal');
      const form = document.getElementById('emailForm');
      const emailInput = document.getElementById('email');
      const consent = document.getElementById('consent');
      const errorBox = document.getElementById('formError');
      const successBox = document.getElementById('formSuccess');
      const submitBtn = document.getElementById('submitBtn');
      const mobileNudge = document.getElementById('mobileNudge');

      let shownThisPage = false;
      let sourceTrigger = 'manual';

      const storageGet = (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const storageSet = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          /* ignore */
        }
      };

      const canPrompt = () =>
        !shownThisPage &&
        Date.now() > Number(storageGet(SNOOZE_KEY) || 0) &&
        !storageGet(SUBMITTED_KEY);

      const snooze = () => storageSet(SNOOZE_KEY, String(Date.now() + 7 * 24 * 60 * 60 * 1000));

      function openModal(trigger: string) {
        if (!canPrompt()) return;
        sourceTrigger = trigger || 'manual';
        shownThisPage = true;
        modal!.classList.remove('hidden');
        modal!.classList.add('flex');
        document.body.style.overflow = 'hidden';
        mobileNudge!.classList.add('hidden');
        setTimeout(() => emailInput!.focus({ preventScroll: true }), 120);
      }

      function closeModal() {
        modal!.classList.add('hidden');
        modal!.classList.remove('flex');
        document.body.style.overflow = '';
        snooze();
      }

      document.getElementById('modalClose')!.addEventListener('click', closeModal);
      modal!.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal!.classList.contains('hidden')) closeModal();
      });

      // 首次点击任何联盟跳转链接 → 先展示订阅弹窗 (弹窗内/底栏内的链接放行)
      document.addEventListener(
        'click',
        (e) => {
          const target = e.target as HTMLElement | null;
          const link = target?.closest?.('a');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          if (!href.startsWith('https://yeahpromos.com/index/index/openurl')) return;
          if (canPrompt() && !link.closest('#dealModal') && !link.closest('#mobileNudge')) {
            e.preventDefault();
            openModal('cta');
            return;
          }
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'affiliate_outbound_click', link_url: href, trigger: sourceTrigger });
          }
        },
        true
      );

      // 桌面端退出意图: 8 秒后激活, 鼠标从视口顶部离开时触发
      let exitReady = false;
      setTimeout(() => {
        exitReady = true;
      }, 8000);
      document.addEventListener('mouseout', (e) => {
        if (exitReady && e.clientY <= 0 && !e.relatedTarget && canPrompt() && window.innerWidth > 700) {
          openModal('exit');
        }
      });

      // 移动端: 38 秒或滚动 68% 后显示底部提示, 不阻断浏览
      let nudgeShown = false;
      function showNudge() {
        if (nudgeShown || !canPrompt() || window.innerWidth > 700) return;
        nudgeShown = true;
        mobileNudge!.classList.remove('hidden');
        mobileNudge!.classList.add('flex');
      }
      setTimeout(showNudge, 38000);
      window.addEventListener(
        'scroll',
        () => {
          const total = document.documentElement.scrollHeight - window.innerHeight || 1;
          if (window.scrollY / total > 0.68) showNudge();
        },
        { passive: true }
      );
      document.getElementById('nudgeOpen')!.addEventListener('click', () => openModal('nudge'));
      document.getElementById('nudgeClose')!.addEventListener('click', () => {
        mobileNudge!.classList.add('hidden');
        snooze();
      });

      // 邮箱提交 (FormSubmit AJAX)
      form!.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBox!.style.display = 'none';
        errorBox!.textContent = '';
        if (!consent!.checked) {
          errorBox!.textContent = 'Please tick the consent box to subscribe.';
          errorBox!.style.display = 'block';
          return;
        }
        const email = emailInput!.value.trim();
        if (!email) {
          emailInput!.focus();
          return;
        }
        submitBtn!.disabled = true;
        submitBtn!.textContent = 'Sending…';
        const payload = {
          email,
          consent: 'Yes — occasional shopping and promotion emails; unsubscribe on request.',
          source: 'AliExpress 11.11 landing page',
          prompt_trigger: sourceTrigger,
          submitted_page: window.location.href,
          _subject: 'New AliExpress deal alert opt-in',
          _template: 'table',
          _honey: '',
        };
        let delivered = false;
        for (const endpoint of FORM_ENDPOINTS) {
          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => ({}));
            if (response.ok && (result.success === true || result.success === 'true')) {
              delivered = true;
              break;
            }
          } catch {
            // 当前端点失败 (未激活/网络), 尝试下一个兑底端点
          }
        }
        if (delivered) {
          form!.style.display = 'none';
          successBox!.style.display = 'block';
          storageSet(SUBMITTED_KEY, '1');
          if (window.dataLayer) {
            window.dataLayer.push({ event: 'email_optin_submitted', form_name: 'aliexpress_deal_alerts' });
          }
        } else {
          errorBox!.textContent = 'Sorry, we could not submit your email right now. Please try again in a moment.';
          errorBox!.style.display = 'block';
        }
        submitBtn!.disabled = false;
        submitBtn!.textContent = 'Send me the deals';
      });
    })();
  </script>
</Layout>
