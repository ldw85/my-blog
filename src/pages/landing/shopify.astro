---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Shopify - Build Your Online Store | Start Selling Today',
  description: 'Create your own online store with Shopify. The all-in-one commerce platform trusted by millions of merchants worldwide. Start your 14-day free trial now.',
};
---

<style is:global>
  /* Override intersection animations for Hero section - show immediately */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }
  .shopify-hero {
    background: linear-gradient(135deg, #1a1f3a 0%, #0f1222 50%, #2d5b27 100%);
  }
  .shopify-btn {
    background: linear-gradient(135deg, #96bf48 0%, #5e8e3e 100%) !important;
    border: 2px solid #96bf48 !important;
    color: #0f1222 !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .shopify-btn:hover {
    background: linear-gradient(135deg, #5e8e3e 0%, #96bf48 100%) !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(150, 191, 72, 0.4) !important;
  }
  .shopify-text {
    color: #96bf48;
  }
  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }
  .stat-card {
    background: linear-gradient(135deg, rgba(150, 191, 72, 0.1) 0%, rgba(45, 91, 39, 0.1) 100%);
    border: 1px solid rgba(150, 191, 72, 0.3);
  }
</style>

<Layout metadata={metadata} showAffiliateDisclosure={true}>
  <!-- Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section shopify-hero">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
          <p class="text-base text-[#96bf48] font-bold tracking-widest uppercase mb-4">
            🌍 Start Your Online Business Today 🌍
          </p>
          <h1 class="text-5xl md:text-7xl font-bold leading-tighter tracking-tighter mb-6 font-heading text-white">
            Build Your Online Store with <span class="shopify-text">Shopify</span>
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-white/80 mb-8 leading-relaxed">
              The all-in-one commerce platform trusted by millions of merchants worldwide. 
              Sell anywhere, anytime — online, in-person, and across the globe.
            </p>
            
            <!-- Promo Badge -->
            <div class="inline-block bg-[#96bf48] text-[#0f1222] px-6 py-3 rounded-full font-bold text-lg mb-8">
              🎯 14-Day Free Trial • No Credit Card Required
            </div>
            
            <!-- Trust Badges -->
            <div class="flex flex-wrap justify-center gap-4 mb-8">
              <div class="bg-white/10 backdrop-blur px-4 py-2 rounded-full text-white text-sm font-medium">
                ✓ $1T+ Total Sales
              </div>
              <div class="bg-white/10 backdrop-blur px-4 py-2 rounded-full text-white text-sm font-medium">
                ✓ 3M+ Merchants
              </div>
              <div class="bg-white/10 backdrop-blur px-4 py-2 rounded-full text-white text-sm font-medium">
                ✓ 175+ Countries
              </div>
            </div>
            
            <div class="max-w-md m-auto flex flex-col sm:flex-row justify-center gap-4">
              <a href="https://go.urtrackinglink.com/aff_c?offer_id=1724&aff_id=163966&redirect_url=https%3A%2F%2Fshopify.pxf.io%2FvNG6yy%3FSubid2%3D%7Btransaction_id%7D%26Subid3%3D%7Baffiliate_id%7D" target="_blank" rel="noopener noreferrer" class="btn btn-primary sm:mb-0 shopify-btn">
                Start Free Trial 🚀
              </a>
            </div>
          </div>
        </div>
        
        <!-- Hero Image -->
        <div class="relative m-auto max-w-5xl">
          <img 
            src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1200&q=80" 
            alt="Shopify - Build Your Online Store"
            class="mx-auto rounded-lg w-full shadow-2xl"
            loading="eager"
            width="1024"
            height="576"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-12 bg-gradient-to-r from-[#1a1f3a] to-[#0f1222] not-prose">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="stat-card p-6 rounded-xl text-center">
          <div class="text-3xl md:text-4xl font-bold text-[#96bf48] mb-2">$1T+</div>
          <div class="text-white/70 text-sm">Total Sales</div>
        </div>
        <div class="stat-card p-6 rounded-xl text-center">
          <div class="text-3xl md:text-4xl font-bold text-[#96bf48] mb-2">3M+</div>
          <div class="text-white/70 text-sm">Merchants</div>
        </div>
        <div class="stat-card p-6 rounded-xl text-center">
          <div class="text-3xl md:text-4xl font-bold text-[#96bf48] mb-2">175+</div>
          <div class="text-white/70 text-sm">Countries</div>
        </div>
        <div class="stat-card p-6 rounded-xl text-center">
          <div class="text-3xl md:text-4xl font-bold text-[#96bf48] mb-2">150M+</div>
          <div class="text-white/70 text-sm">Shoppers</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Shopify -->
  <Features
    title="Why Choose Shopify?"
    subtitle="The world's leading e-commerce platform"
    items={[
      {
        title: '🛒 #1 Conversion Checkout',
        description: 'Shopify Checkout converts 15% higher on average. Expose your brand to 150 million buy-ready shoppers.',
      },
      {
        title: '⚡ Blazing Fast Speed',
        description: 'Your store is within 50 milliseconds of every shopper on the planet. Lightning-fast loading times.',
      },
      {
        title: '🤖 AI-Powered Design',
        description: 'Design your store in minutes with AI. Choose from stylish themes or build completely custom.',
      },
      {
        title: '💰 Shopify Capital',
        description: 'Get funding up to $2M to grow your business. 0% equity — no stake taken, ever.',
      },
    ]}
  />

  <!-- What You Can Sell -->
  <Content
    title="What Can You Sell on Shopify?"
    subtitle="Everything you need to run your business"
    items={[
      {
        title: '👕 Physical Products',
        description: 'Clothing, accessories, electronics, furniture — ship products to customers anywhere.',
      },
      {
        title: '📥 Digital Products',
        description: 'Sell ebooks, courses, downloads, and digital services. Automated delivery 24/7.',
      },
      {
        title: '💳 Services & Bookings',
        description: 'Offer consultations, appointments, and services. Built-in scheduling and payments.',
      },
      {
        title: '🎫 Subscriptions',
        description: 'Create recurring revenue with subscription boxes, memberships, and recurring billing.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80',
      alt: 'Shopify Products',
    }}
  />

  <!-- Key Features -->
  <Features
    title="Everything You Need to Succeed"
    subtitle="Powerful built-in tools for your business"
    columns={3}
    items={[
      {
        title: '📱 Sell Everywhere',
        description: 'Online store, social media, marketplaces. One inventory, unlimited channels.',
      },
      {
        title: '📊 Built-in Analytics',
        description: 'Track sales, customers, and growth. Make data-driven decisions with real-time insights.',
      },
      {
        title: '🔌 13,000+ Apps',
        description: 'Extend your store with specialized apps for marketing, shipping, and more.',
      },
      {
        title: '🌍 Global Commerce',
        description: 'Sell in multiple currencies and languages. Reach customers around the world.',
      },
      {
        title: '🔒 Secure Payments',
        description: 'Accept all major payment methods. Secure, reliable, and merchant-friendly.',
      },
      {
        title: '📞 24/7 Support',
        description: 'Expert help whenever you need it. Phone, chat, and email support available.',
      },
    ]}
  />

  <!-- Who Uses Shopify -->
  <Features
    title="Who Uses Shopify?"
    subtitle: 'From startups to enterprise brands'
    columns={2}
    items={[
      {
        title: '🏪 Small Businesses',
        description: 'Start selling online in minutes. Perfect for new entrepreneurs and small businesses.',
      },
      {
        title: '📈 Growing Brands',
        description: 'Scale your business with powerful tools. From 100 to 100,000 orders.',
      },
      {
        title: '🏢 Enterprise',
        description: 'Custom solutions for large organizations. Advanced features and dedicated support.',
      },
      {
        title: '🌟 Global Brands',
        description: 'World-renowned brands trust Shopify for their online stores and omnichannel commerce.',
      },
    ]}
  />

  <!-- Pricing Section -->
  <section class="py-16 not-prose">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Simple, Transparent Pricing</h2>
        <p class="text-xl text-gray-600">Start free, scale as you grow. No hidden fees.</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Basic -->
        <div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-transparent hover:border-[#96bf48] transition-all">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Starter</h3>
          <p class="text-gray-500 mb-4">For new entrepreneurs</p>
          <div class="text-4xl font-bold text-[#1a1f3a] mb-6">$5<span class="text-lg text-gray-500">/mo</span></div>
          <ul class="space-y-3 text-gray-600 mb-8">
            <li>✓ Up to 1,000 products</li>
            <li>✓ 2 staff accounts</li>
            <li>✓ Basic analytics</li>
            <li>✓ 24/7 support</li>
          </ul>
          <a href="https://go.urtrackinglink.com/aff_c?offer_id=1724&aff_id=163966&redirect_url=https%3A%2F%2Fshopify.pxf.io%2FvNG6yy%3FSubid2%3D%7Btransaction_id%7D%26Subid3%3D%7Baffiliate_id%7D" target="_blank" class="block w-full py-3 bg-gray-100 text-center rounded-lg font-semibold text-[#1a1f3a] hover:bg-gray-200 transition">
            Start Free Trial
          </a>
        </div>
        
        <!-- Popular -->
        <div class="bg-[#1a1f3a] rounded-2xl shadow-lg p-8 border-2 border-[#96bf48] transform scale-105">
          <div class="bg-[#96bf48] text-[#0f1222] text-sm font-bold px-3 py-1 rounded-full inline-block mb-2">MOST POPULAR</div>
          <h3 class="text-2xl font-bold text-white mb-2">Basic</h3>
          <p class="text-white/70 mb-4">For growing businesses</p>
          <div class="text-4xl font-bold text-white mb-6">$15<span class="text-lg text-white/70">/mo</span></div>
          <ul class="space-y-3 text-white/80 mb-8">
            <li>✓ Unlimited products</li>
            <li>✓ 5 staff accounts</li>
            <li>✓ Professional reports</li>
            <li>✓ Free SSL certificate</li>
          </ul>
          <a href="https://go.urtrackinglink.com/aff_c?offer_id=1724&aff_id=163966&redirect_url=https%3A%2F%2Fshopify.pxf.io%2FvNG6yy%3FSubid2%3D%7Btransaction_id%7D%26Subid3%3D%7Baffiliate_id%7D" target="_blank" class="block w-full py-3 bg-[#96bf48] text-center rounded-lg font-semibold text-[#0f1222] hover:bg-[#7aa83d] transition">
            Start Free Trial
          </a>
        </div>
        
        <!-- Pro -->
        <div class="bg-white rounded-2xl shadow-lg p-8 border-2 border-transparent hover:border-[#96bf48] transition-all">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Shopify</h3>
          <p class="text-gray-500 mb-4">For scaling brands</p>
          <div class="text-4xl font-bold text-[#1a1f3a] mb-6">$49<span class="text-lg text-gray-500">/mo</span></div>
          <ul class="space-y-3 text-gray-600 mb-8">
            <li>✓ Everything in Basic</li>
            <li>✓ 15 staff accounts</li>
            <li>✓ Gift cards</li>
            <li>✓ Professional analytics</li>
          </ul>
          <a href="https://go.urtrackinglink.com/aff_c?offer_id=1724&aff_id=163966&redirect_url=https%3A%2F%2Fshopify.pxf.io%2FvNG6yy%3FSubid2%3D%7Btransaction_id%7D%26Subid3%3D%7Baffiliate_id%7D" target="_blank" class="block w-full py-3 bg-gray-100 text-center rounded-lg font-semibold text-[#1a1f3a] hover:bg-gray-200 transition">
            Start Free Trial
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Stories -->
  <Content
    title="Success Stories"
    subtitle="Join millions of merchants building their dreams"
    items={[
      {
        title: '🚀 Fastest Growing Brands',
        description: 'From startup to million-dollar business in record time. See how brands use Shopify to scale.',
      },
      {
        title: '🌍 Global Reach',
        description: 'Sell to customers in 175+ countries. Localized checkout in their preferred currency.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80',
      alt: 'Shopify Success',
    }}
  />

  <!-- CTA -->
  <CallToAction
    title="Start Your Online Business Today"
    subtitle="Join 3 million+ merchants worldwide. Get your 14-day free trial and start selling in minutes!"
    actions={[
      { variant: 'primary', text: 'Start Free Trial 🚀', href: 'https://go.urtrackinglink.com/aff_c?offer_id=1724&aff_id=163966&redirect_url=https%3A%2F%2Fshopify.pxf.io%2FvNG6yy%3FSubid2%3D%7Btransaction_id%7D%26Subid3%3D%7Baffiliate_id%7D', target: '_blank' },
    ]}
  />
</Layout>
