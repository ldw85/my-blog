---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Book Cheapest Flight Tickets Online | Middle East',
  description: 'Discover the cheapest flight tickets to global destinations. Compare prices from hundreds of airlines and book now the easy way.',
};
---

<style is:global>
  /* Override intersection animations for Hero section - show immediately */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }
  .wego-hero {
    background: linear-gradient(135deg, #00a698 0%, #00d2be 50%, #00f5c4 100%);
  }
  .wego-text {
    color: #00a698;
  }
  .wego-btn {
    background: linear-gradient(135deg, #00a698 0%, #008b7d 100%) !important;
    border: 2px solid #00a698 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .wego-btn:hover {
    background: linear-gradient(135deg, #00d2be 0%, #00a698 100%) !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 166, 152, 0.4) !important;
  }
  .trust-badge {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }
</style>

<Layout metadata={metadata} showAffiliateDisclosure={false}>
  <!-- Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section wego-hero">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
          <p class="text-base text-white font-bold tracking-widest uppercase mb-4">
            Cheapest Flight Prices in Middle East
          </p>
          <h1 class="text-5xl md:text-7xl font-bold leading-tighter tracking-tighter mb-6 font-heading text-white">
            Book Your Flight with <span class="text-white">Top Platform</span>
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
              Compare prices from 700+ airlines and booking sites. Find the cheapest fares and book in seconds
            </p>
            
            <!-- Promo Badge -->
            <div class="inline-block bg-white text-[#00a698] px-6 py-3 rounded-full font-bold text-lg mb-8">
              Up to 50% Off on Select Destinations!
            </div>
            
            <!-- Trust Badges -->
            <div class="flex flex-wrap justify-center gap-4 mb-8">
              <div class="trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                700+ Airlines
              </div>
              <div class="trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                Best Price Guarantee
              </div>
              <div class="trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                Easy Booking
              </div>
            </div>
            
            <div class="max-w-md m-auto flex flex-col sm:flex-row justify-center gap-4">
              <a href="https://go.urtrackinglink.com/SH8PR" target="_blank" rel="noopener noreferrer" class="btn btn-primary sm:mb-0 wego-btn">
                Book Your Flight Now 🛫
              </a>
            </div>
          </div>
        </div>
        
        <!-- Hero Image -->
        <div class="relative m-auto max-w-5xl">
          <img 
            src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1200&q=80" 
            alt="Book Flight Tickets Online"
            class="mx-auto rounded-lg w-full shadow-2xl"
            loading="eager"
            width="1024"
            height="576"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <Features
    title="Why Choose Our Platform?"
    subtitle="Best flight booking platform in the region"
    items={[
      {
        title: 'Comprehensive Comparison',
        description: 'Compare prices from different airlines in one place. Find the best deal easily.',
      },
      {
        title: 'Discounted Prices',
        description: 'We offer the cheapest prices with a best price guarantee. Save your money.',
      },
      {
        title: 'Global Destinations',
        description: 'Book flights to thousands of destinations worldwide. From Dubai anywhere.',
      },
      {
        title: 'Real Reviews',
        description: 'Read real traveler experiences before booking. Decision based on reliable info.',
      },
    ]}
  />

  <!-- How to Book -->
  <Content
    title="How to Book in 3 Steps"
    subtitle="Book your flight in minutes"
    items={[
      {
        title: 'Search Your Flight',
        description: 'Enter your destination and travel dates. We compare all airline prices.',
      },
      {
        title: 'Compare and Choose',
        description: 'Browse results and pick the best price that fits your budget and schedule.',
      },
      {
        title: 'Book Easily',
        description: 'Complete your booking securely through our platform. Get instant confirmation.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1569154941061-e231b4725ef1?w=800&q=80',
      alt: 'Easy Flight Booking',
    }}
  />

  <!-- Popular Destinations -->
  <Features
    title="Most Popular Destinations"
    subtitle="Find your perfect flight"
    columns={3}
    items={[
      {
        title: 'Istanbul, Turkey',
        description: 'Flight to Istanbul at great prices. Explore history and culture.',
      },
      {
        title: 'Sharm El Sheikh, Egypt',
        description: 'Book your flight to Sharm El Sheikh and enjoy Red Sea beaches.',
      },
      {
        title: 'Thailand',
        description: 'Fly to Thailand and enjoy tropical paradise and nature.',
      },
    ]}
  />

  <!-- Additional Features -->
  <Features
    title="Our Features"
    subtitle="Everything you need for perfect booking"
    columns={2}
    items={[
      {
        title: 'Secure Booking',
        description: 'Your personal data is fully secured. Safe and reliable booking.',
      },
      {
        title: 'Customer Support',
        description: '24/7 support team to help you with any questions.',
      },
      {
        title: 'Exclusive Deals',
        description: 'Get exclusive discounts and offers only for our members.',
      },
      {
        title: 'Book from Your Phone',
        description: 'Book anytime, anywhere through our mobile-friendly platform.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Start Your Journey Now"
    subtitle="Don't miss out! Book your flight at the best prices and enjoy an unforgettable trip."
    actions={[
      { variant: 'primary', text: 'Book Your Flight Now 🛫', href: 'https://go.urtrackinglink.com/SH8PR', target: '_blank' },
    ]}
  />
</Layout>
