---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// AliExpress 联盟跟踪链接 (PartnerBoost, brand_id 72898, Joined)
// 短链由 PartnerBoost 生成, 跳转 aliexpress.com 并携带联盟归因
const AFFILIATE_URL = 'https://pboost.me/F6tLC45i4';

const metadata = {
  title: 'AliExpress 11.11 Shopping Event - E-commerce Deals',
  description:
    'Shop the AliExpress 11.11 shopping event: tech, home, fashion and gift finds with free shipping on eligible Choice orders, buyer protection and seasonal offers.',
};
---

<style is:global>
  /* Override intersection animations for Hero section - show immediately */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }
  .ali-hero {
    background: linear-gradient(135deg, #ff8a3d 0%, #ff6a00 45%, #e62e04 100%);
  }
  .ali-btn {
    background: #ff6a00 !important;
    border: 2px solid #ff6a00 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .ali-btn:hover {
    background: #e62e04 !important;
    border-color: #e62e04 !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(230, 46, 4, 0.4) !important;
  }
  .ali-outline-btn {
    background: transparent !important;
    border: 2px solid rgba(255, 255, 255, 0.7) !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .ali-outline-btn:hover {
    background: rgba(255, 255, 255, 0.14) !important;
    transform: translateY(-2px);
  }
  .ali-brand-mark {
    background: #ffffff;
    color: #ff6a00;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ali-trust-badge {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.32);
  }
  .ali-category:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(230, 46, 4, 0.18);
  }
  .ali-category-link {
    color: #e62e04;
    letter-spacing: 0.04em;
  }
</style>

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section ali-hero">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-14 max-w-5xl mx-auto">
          <p class="text-base text-white font-bold tracking-widest uppercase mb-4">
            The 11.11 Shopping Event · Nov 1–18
          </p>
          <h1
            class="text-5xl md:text-7xl font-bold leading-tighter tracking-tighter mb-6 font-heading text-white"
          >
            Good finds. <em class="not-italic text-[#ffe08a]">Better prices.</em>
            <br />Only on <span class="ali-brand-mark px-3 py-1 rounded-xl inline-block">AliExpress</span>
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
              Explore seasonal offers across tech, home, fashion and gift-worthy finds — millions of
              products in one global marketplace.
            </p>

            <!-- Promo Badge -->
            <div
              class="inline-block bg-white text-[#e62e04] px-6 py-3 rounded-full font-bold text-lg mb-8"
            >
              11.11 Seasonal Deals · Through Nov 18, 2026
            </div>

            <!-- Trust Badges -->
            <div class="flex flex-wrap justify-center gap-4 mb-8">
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                📦 Free shipping on eligible Choice orders
              </div>
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                🛡️ Buyer protection
              </div>
              <div class="ali-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                ↩️ Free returns on eligible items
              </div>
            </div>

            <div class="max-w-xl m-auto flex flex-col sm:flex-row justify-center gap-4">
              <a
                href={AFFILIATE_URL}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="btn btn-primary sm:mb-0 ali-btn"
              >
                Shop AliExpress Now ↗
              </a>
              <a href="#categories" class="btn ali-outline-btn">Browse categories</a>
            </div>
            <p class="text-white/70 text-xs mt-4">
              Offers and eligibility vary by item. Shopping links use affiliate tracking.
            </p>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="relative m-auto max-w-5xl">
          <img
            src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1200&q=80"
            alt="Seasonal online shopping deals on AliExpress"
            class="mx-auto rounded-lg w-full shadow-2xl"
            loading="eager"
            width="1024"
            height="576"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Shopping Benefits -->
  <section class="py-14 not-prose" aria-label="Shopping benefits">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">📦</div>
          <b class="block text-sm">Free shipping</b>
          <span class="block text-xs text-gray-500 mt-1">On eligible Choice orders</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">🚚</div>
          <b class="block text-sm">Fast delivery</b>
          <span class="block text-xs text-gray-500 mt-1">On qualifying items</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">↩️</div>
          <b class="block text-sm">Free returns</b>
          <span class="block text-xs text-gray-500 mt-1">Eligible items, terms apply</span>
        </div>
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm text-center">
          <div class="text-3xl mb-2">✦</div>
          <b class="block text-sm">New lower prices</b>
          <span class="block text-xs text-gray-500 mt-1">Selected seasonal offers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Shop by Category -->
  <section id="categories" class="py-14 not-prose scroll-mt-24" aria-labelledby="categories-title">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="text-sm font-bold uppercase tracking-widest text-[#e62e04] mb-3">
          Find your kind of deal
        </div>
        <h2 id="categories-title" class="text-4xl md:text-5xl font-bold tracking-tighter mb-4">
          Explore by interest
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Start with a category, then browse current offers and check item details, delivery options
          and return terms.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1498049794561-7780e7231661?auto=format&fit=crop&w=700&q=75"
            alt="Technology and electronics accessories on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Tech &amp; Electronics</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Everyday tech, devices and useful accessories.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=700&q=75"
            alt="Kitchen and home essentials on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Home &amp; Kitchen</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Practical upgrades for cooking, storage and home.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=700&q=75"
            alt="Fashion and accessories shopping on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Fashion &amp; Accessories</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Fresh looks, useful extras and everyday style.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>

        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="ali-category group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300"
        >
          <img
            loading="lazy"
            src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?auto=format&fit=crop&w=700&q=75"
            alt="Wrapped gifts and seasonal finds on AliExpress"
            class="w-full h-40 object-cover"
            width="350"
            height="160"
          />
          <div class="p-4">
            <b class="block text-base">Gifts &amp; Seasonal Finds</b>
            <p class="text-xs text-gray-500 my-2 min-h-[32px]">
              Gift inspiration for the holidays and beyond.
            </p>
            <span class="ali-category-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
              EXPLORE FINDS →
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Shopping Tips -->
  <section class="py-16 not-prose bg-gradient-to-br from-orange-50 to-amber-50" aria-labelledby="tips-title">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <div class="text-sm font-bold uppercase tracking-widest text-[#a66e0d] mb-3">
          A smarter way to browse
        </div>
        <h2 id="tips-title" class="text-4xl font-bold tracking-tighter mb-4">
          A good deal is more than a low price.
        </h2>
        <p class="text-gray-600 mb-6">
          Before checking out on AliExpress, take a moment to compare the item details and make sure
          the offer fits what you need.
        </p>
        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="btn ali-btn"
        >
          Browse current offers →
        </a>
      </div>
      <div class="grid gap-3">
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            01
          </div>
          <div>
            <b class="block text-sm">Check the full price</b>
            <span class="block text-xs text-gray-500 mt-1">
              Review the current item price, shipping costs and any coupon conditions.
            </span>
          </div>
        </div>
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            02
          </div>
          <div>
            <b class="block text-sm">Review delivery estimates</b>
            <span class="block text-xs text-gray-500 mt-1">
              Delivery options and arrival dates can differ by item and destination.
            </span>
          </div>
        </div>
        <div class="flex gap-3 bg-white/80 border border-orange-100 rounded-xl p-4">
          <div
            class="w-8 h-8 rounded-lg bg-[#171a1f] text-[#f8d47b] grid place-items-center font-bold text-xs flex-none"
          >
            03
          </div>
          <div>
            <b class="block text-sm">Read return conditions</b>
            <span class="block text-xs text-gray-500 mt-1">
              Confirm whether the selected item qualifies for free returns and the applicable window.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CallToAction
    title="Ready to explore the AliExpress 11.11 sale?"
    subtitle="Browse a broad marketplace of products and discover current seasonal offers. Prices, availability and benefits are set by the retailer and may change."
    actions={[
      {
        variant: 'primary',
        text: 'Go to AliExpress ↗',
        href: AFFILIATE_URL,
        target: '_blank',
        rel: 'noopener noreferrer sponsored',
      },
    ]}
  />

  <!-- Affiliate Disclosure -->
  <section class="not-prose pb-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="border border-gray-200 rounded-xl bg-white p-5 text-xs text-gray-500 leading-relaxed">
        <b>Affiliate disclosure:</b> This is an independent shopping guide. We may earn a commission
        if you make a purchase through links on this page, at no additional cost to you. We are not
        the retailer and are not an official website or representative of AliExpress. Product prices,
        promotions, shipping, delivery and return eligibility are controlled by the retailer and may
        vary. Please review the retailer's current terms before purchasing.
      </div>
    </div>
  </section>
</Layout>
