---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

// adidas UAE 联盟跟踪链接 (YeahPromos)
// 格式: track=<ID>&url=<目标页>, url 为官方大促页 (adidas.ae Singles Day)
const AFFILIATE_URL =
  'https://yeahpromos.com/index/index/openurl?track=26c13b09cd60422d&url=https%3A%2F%2Fwww.adidas.ae%2Fen%2Fsingles_day';

// 官方品牌站点 (同样走跟踪链接, 保持归因一致)
const AFFILIATE_BRAND_URL =
  'https://yeahpromos.com/index/index/openurl?track=26c13b09cd60422d&url=https%3A%2F%2Fwww.adidas.ae%2F';

const metadata = {
  title: 'adidas UAE 11.11 Sale — 30–60% Off Selected Styles | TechReviews',
  description:
    'The official adidas UAE 11.11 Singles Day sale: 30–60% off selected shoes, clothing, football gear and accessories on the official UAE store.',
};
---

<style is:global>
  /* 关闭 Hero 区块的入场动画, 保证首屏立即可见 */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }

  /* adidas 品牌色: 经典黑 + 石墨灰, 折扣高亮用荧光绿 */
  .adi-hero {
    background: linear-gradient(135deg, #111111 0%, #1c1c1c 55%, #2b2b2b 100%);
  }
  .adi-lime {
    color: #d7ff00;
  }
  .adi-lime-bg {
    background: #d7ff00;
    color: #111111;
  }
  .adi-wordmark {
    font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    letter-spacing: -0.06em;
    text-transform: lowercase;
  }
  .adi-btn {
    background: #d7ff00 !important;
    border: 2px solid #d7ff00 !important;
    color: #111111 !important;
    font-weight: 800 !important;
    transition: all 0.3s ease !important;
  }
  .adi-btn:hover {
    background: #b9e000 !important;
    border-color: #b9e000 !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(215, 255, 0, 0.25) !important;
  }
  .adi-outline-btn {
    background: transparent !important;
    border: 2px solid rgba(255, 255, 255, 0.55) !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    transition: all 0.3s ease !important;
  }
  .adi-outline-btn:hover {
    background: rgba(255, 255, 255, 0.12) !important;
    transform: translateY(-2px);
  }
  .adi-trust-badge {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }
  .adi-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.14);
  }
  .adi-link {
    color: #0f7a00;
    letter-spacing: 0.04em;
  }
  .adi-link-dark {
    color: #a4d000;
    letter-spacing: 0.04em;
  }
  .adi-modal-badge {
    background: #d7ff00;
    color: #111111;
  }
  .adi-modal-offer {
    background: linear-gradient(90deg, #111111 0%, #2f2f2f 100%);
    color: #ffffff;
  }
  .adi-modal-offer strong {
    color: #d7ff00;
  }
</style>

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section adi-hero">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-14 max-w-5xl mx-auto">
          <!-- 官方品牌标识 -->
          <a
            href={AFFILIATE_BRAND_URL}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="inline-block mb-6 group"
            aria-label="adidas UAE official store"
          >
            <span
              class="adi-wordmark inline-flex items-center gap-3 bg-white text-black px-6 py-3 rounded-2xl text-3xl md:text-4xl shadow-2xl group-hover:-translate-y-1 transition-transform"
            >
              adidas
              <span class="text-sm md:text-base font-bold tracking-widest uppercase text-black/60">
                UAE
              </span>
            </span>
            <span class="block mt-3 text-white/60 text-xs tracking-[0.2em] uppercase">
              Official UAE Store · www.adidas.ae
            </span>
          </a>

          <p class="text-base text-[#d7ff00] font-bold tracking-widest uppercase mb-4">
            The 11.11 Singles Day Sale
          </p>
          <h1
            class="text-5xl md:text-7xl font-bold leading-tighter tracking-tighter mb-6 font-heading text-white"
          >
            11.11 <span class="adi-lime">SALE</span> IS ON.
          </h1>

          <!-- 折扣徽章 -->
          <div class="inline-block adi-lime-bg px-6 py-3 rounded-xl font-extrabold text-xl md:text-2xl mb-8">
            30–60% OFF SELECTED STYLES
          </div>

          <div class="max-w-3xl mx-auto">
            <p class="text-xl md:text-2xl text-white/90 mb-8 leading-relaxed">
              The season’s best, for less. Discover selected shoes, clothing, football gear and
              accessories for every move — on the official adidas UAE store.
            </p>

            <!-- Trust Badges -->
            <div class="flex flex-wrap justify-center gap-4 mb-8">
              <div class="adi-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                👟 Shoes · Football · Apparel
              </div>
              <div class="adi-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                🚚 Official UAE Store Shipping
              </div>
              <div class="adi-trust-badge px-4 py-2 rounded-full text-white text-sm font-medium">
                ✦ adiClub Member Benefits
              </div>
            </div>

            <div class="max-w-xl m-auto flex flex-col sm:flex-row justify-center gap-4">
              <a
                href={AFFILIATE_URL}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="btn btn-primary sm:mb-0 adi-btn"
              >
                Shop the 11.11 Sale ↗
              </a>
              <a href="#categories" class="btn adi-outline-btn">Browse categories</a>
            </div>
            <p class="text-white/60 text-xs mt-4">
              Offers apply to selected styles. Discounts, availability and prices may change on the
              official store.
            </p>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="relative m-auto max-w-5xl">
          <img
            src="https://assets.adidas.com/images/w_1080%2Cf_auto%2Cq_auto/1fa18f47b66e4f4980ba74d48de04ecc_9366/IF7087_01_standard.jpg"
            alt="Sports footwear from the official adidas UAE 11.11 sale collection"
            class="mx-auto rounded-lg w-full max-w-2xl shadow-2xl"
            loading="eager"
            width="1080"
            height="1080"
          />
          <div
            class="absolute left-4 bottom-4 adi-lime-bg px-3 py-2 rounded-lg text-xs font-extrabold tracking-widest uppercase"
          >
            Up to 60% off selected styles
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 品牌横幅 -->
  <section class="py-6 not-prose bg-[#111111] text-white" aria-label="Brand highlights">
    <div class="max-w-6xl mx-auto px-4">
      <p class="text-center text-lg md:text-2xl font-bold tracking-wide uppercase">
        More style. More movement. <span class="adi-lime">More savings.</span>
      </p>
    </div>
  </section>

  <!-- 官方品牌网站入口 -->
  <section class="py-14 not-prose" aria-labelledby="brand-title">
    <div class="max-w-5xl mx-auto px-4">
      <div class="bg-[#111111] rounded-3xl p-8 md:p-12 text-center shadow-2xl">
        <span class="adi-wordmark inline-block text-white text-4xl md:text-5xl mb-3">adidas</span>
        <p class="text-[#d7ff00] text-sm font-bold tracking-[0.2em] uppercase mb-4">
          United Arab Emirates
        </p>
        <h2 id="brand-title" class="text-2xl md:text-3xl font-bold text-white mb-3">
          Shop on the official adidas UAE website
        </h2>
        <p class="text-white/70 max-w-2xl mx-auto mb-8 leading-relaxed">
          Every link on this page opens the official adidas UAE store — full 11.11 pricing, the
          complete product range and adiClub benefits, straight from the brand.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href={AFFILIATE_BRAND_URL}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="btn adi-btn"
          >
            Visit adidas UAE ↗
          </a>
          <a
            href={AFFILIATE_URL}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="btn adi-outline-btn"
          >
            Shop the 11.11 Sale →
          </a>
        </div>
        <p class="text-white/40 text-xs mt-5 tracking-widest uppercase">www.adidas.ae</p>
      </div>
    </div>
  </section>

  <!-- 分类入口 -->
  <section id="categories" class="py-14 not-prose scroll-mt-24" aria-labelledby="categories-title">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="text-sm font-bold uppercase tracking-widest adi-link-dark mb-3">
          Find your next favourite
        </div>
        <h2 id="categories-title" class="text-4xl md:text-5xl font-bold tracking-tighter mb-4">
          Shop by category
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Explore a wide selection across sport and everyday style, then check current offers on the
          official store.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          [
            {
              title: 'Shoes',
              desc: 'Running · Lifestyle · Training',
            },
            {
              title: 'Clothing',
              desc: 'Tops · Bottoms · Layers',
            },
            {
              title: 'Football',
              desc: 'Boots · Jerseys · Training',
            },
            {
              title: 'Accessories',
              desc: 'Bags · Socks · Essentials',
            },
          ].map((cat) => (
            <a
              href={AFFILIATE_URL}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="adi-card group block bg-white rounded-2xl shadow-md overflow-hidden transition-all duration-300 border border-gray-100"
            >
              <div class="h-28 bg-[#111111] flex items-center justify-center">
                <span class="adi-wordmark text-white text-3xl">adidas</span>
              </div>
              <div class="p-5">
                <b class="block text-base mb-1">{cat.title}</b>
                <p class="text-xs text-gray-500 mb-3">{cat.desc}</p>
                <span class="adi-link text-[11px] font-bold group-hover:translate-x-1 transition-transform inline-block">
                  EXPLORE OFFERS →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- adiClub 会员 -->
  <section class="py-16 not-prose bg-gray-50" aria-labelledby="club-title">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <div class="text-sm font-bold uppercase tracking-widest adi-link-dark mb-3">
          Member benefits
        </div>
        <h2 id="club-title" class="text-4xl font-bold tracking-tighter mb-4">Join adiClub.</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Get rewarded every step of the way. Explore membership benefits and the latest offers on
          the official store.
        </p>
        <a
          href={AFFILIATE_URL}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="btn adi-btn"
        >
          Discover more →
        </a>
      </div>
      <div class="grid gap-3">
        {
          [
            {
              n: '01',
              t: 'Members-only pricing',
              d: 'Extra discounts and early access to seasonal offers on the official store.',
            },
            {
              n: '02',
              t: 'Free delivery & easy returns',
              d: 'Check the current delivery options and return window for eligible items.',
            },
            {
              n: '03',
              t: 'Rewards on every purchase',
              d: 'Earn points on adidas UAE orders and redeem them on the official store.',
            },
          ].map((step) => (
            <div class="flex gap-3 bg-white border border-gray-100 rounded-xl p-4 shadow-sm">
              <div class="w-8 h-8 rounded-lg bg-[#111111] text-[#d7ff00] grid place-items-center font-bold text-xs flex-none">
                {step.n}
              </div>
              <div>
                <b class="block text-sm">{step.t}</b>
                <span class="block text-xs text-gray-500 mt-1">{step.d}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 最终 CTA -->
  <CallToAction
    title="The season’s best, for less."
    subtitle="Shop selected styles with 30–60% off during the adidas UAE 11.11 sale on the official store."
    actions={[
      {
        variant: 'primary',
        text: 'Shop the official sale ↗',
        href: AFFILIATE_URL,
        target: '_blank',
        rel: 'noopener noreferrer sponsored',
      },
    ]}
  />

  <!-- 联盟声明 -->
  <section class="not-prose pb-14">
    <div class="max-w-4xl mx-auto px-4">
      <div class="border border-gray-200 rounded-xl bg-white p-5 text-xs text-gray-500 leading-relaxed">
        <b>Affiliate disclosure:</b> This is an independent shopping guide. We may earn a commission
        if you make a purchase through links on this page, at no additional cost to you. We are not
        the retailer and are not an official website or representative of adidas. Product prices,
        promotions, availability and offers are controlled by adidas and may vary. Please review the
        official store’s current terms before purchasing.
      </div>
    </div>
  </section>

  <!-- 退出弹窗: 离开页面时展示 11.11 折扣信息并收集邮箱 (FormSubmit) -->
  <div
    id="dealModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
  >
    <div class="relative w-full max-w-md bg-white rounded-3xl p-7 shadow-2xl">
      <button
        id="modalClose"
        type="button"
        aria-label="Close"
        class="absolute right-4 top-4 w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 text-xl leading-none"
      >
        ×
      </button>
      <span
        class="inline-block adi-modal-badge rounded-full px-3 py-1.5 text-[11px] font-bold tracking-widest uppercase"
      >
        🔥 11.11 Exclusive Offer
      </span>
      <h3 id="modalTitle" class="text-2xl font-bold tracking-tight mt-4 pr-8">
        Wait — don’t miss your <span class="adi-lime">11.11 discount</span>!
      </h3>
      <div class="adi-modal-offer rounded-2xl px-4 py-3 mt-4 text-sm font-bold">
        🎁 Extra coupon codes inside — <strong>30–60% off</strong> selected adidas styles, plus
        adiClub member benefits.
      </div>
      <p class="text-sm text-gray-500 mt-4 mb-4">
        Leave your email and we’ll send you adidas UAE 11.11 discount codes and deal alerts. No
        purchase needed — unsubscribe anytime.
      </p>
      <form
        id="emailForm"
        action="https://formsubmit.co/b56e265310430d01940ba1176e9bacde"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New adidas UAE 11.11 deal alert opt-in" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="source" value="adidas UAE 11.11 landing page" />
        <div class="flex flex-col gap-2">
          <input
            type="email"
            name="email"
            id="email"
            placeholder="Your email address"
            autocomplete="email"
            required
            aria-label="Your email address"
            class="border border-gray-300 rounded-xl px-3.5 py-3 text-sm outline-none focus:border-black focus:ring-2 focus:ring-black/15"
          />
          <button
            id="submitBtn"
            type="submit"
            class="adi-modal-badge font-bold rounded-xl py-3 text-sm transition-colors"
          >
            Send me the deals
          </button>
        </div>
        <label class="flex items-start gap-2 text-[11px] text-gray-500 mt-3">
          <input type="checkbox" id="consent" required class="mt-0.5 accent-black" />
          <span>
            I agree to receive occasional shopping and promotion emails. I can withdraw my consent
            by replying “unsubscribe” or contacting the site operator.
          </span>
        </label>
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] w-px h-px"
        />
        <p class="text-[10px] text-gray-400 mt-2">
          Your email is sent to the site operator through FormSubmit. See our
          <a href="/privacy" target="_blank" rel="noopener" class="underline">privacy policy</a>.
        </p>
        <p id="formError" role="alert" class="hidden text-[11px] text-red-600 mt-2"></p>
      </form>
      <div
        id="formSuccess"
        class="hidden bg-green-50 border border-green-200 text-green-700 rounded-xl p-3 text-sm mt-4"
      >
        🎉 Thanks — you’re on the list! Watch your inbox for 11.11 discount codes.
      </div>
      <a
        id="continueLink"
        href={AFFILIATE_URL}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block text-center mt-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition-colors"
      >
        No thanks — continue to adidas UAE →
      </a>
    </div>
  </div>

  <!-- 移动端底部订阅提示 -->
  <div
    id="mobileNudge"
    class="hidden fixed z-40 bottom-3 left-3 right-3 bg-[#111111] text-white rounded-2xl px-4 py-3 shadow-2xl items-center justify-between gap-3 text-sm"
    role="status"
    aria-live="polite"
  >
    <span>🎁 Get 11.11 discount codes by email</span>
    <button
      id="nudgeOpen"
      type="button"
      class="adi-modal-badge font-bold rounded-full px-3.5 py-2 text-xs whitespace-nowrap"
    >
      Get deals
    </button>
    <button
      id="nudgeClose"
      type="button"
      aria-label="Dismiss"
      class="text-white/70 px-1 text-lg leading-none"
    >
      ×
    </button>
  </div>

  <script>
    // 退出意图弹窗逻辑: 桌面端鼠标离开视口顶部触发, 移动端用非阻断式底栏;
    // 首次点击联盟链接也先弹窗(可跳过); localStorage 记录 snooze/已订阅状态
    (function () {
      'use strict';
      // GTM / GA4 数据层 (页面未加载 GTM 时为 undefined, 统一在此声明类型)
      const dataLayer = (window as unknown as { dataLayer?: unknown[] }).dataLayer;
      const AFFILIATE_PREFIX = 'https://yeahpromos.com/index/index/openurl';
      // FormSubmit 端点链: 随机串主端点 (官方建议, 隐藏收件邮箱防爬虫收割) + 邮箱兜底端点;
      // 随机串端点首次使用需点击邮件激活 (按域名绑定), 激活前由兜底端点保证提交成功
      const FORM_ENDPOINTS = [
        'https://formsubmit.co/ajax/b56e265310430d01940ba1176e9bacde',
        'https://formsubmit.co/ajax/ldwldw85@outlook.com',
      ];
      const SNOOZE_KEY = 'adidas_uae_snooze_v1';
      const SUBMITTED_KEY = 'adidas_uae_submitted';

      const modal = document.getElementById('dealModal');
      const form = document.getElementById('emailForm') as HTMLFormElement | null;
      const emailInput = document.getElementById('email') as HTMLInputElement | null;
      const consent = document.getElementById('consent') as HTMLInputElement | null;
      const errorBox = document.getElementById('formError');
      const successBox = document.getElementById('formSuccess');
      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const mobileNudge = document.getElementById('mobileNudge');

      let shownThisPage = false;
      let sourceTrigger = 'manual';

      const storageGet = (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      };
      const storageSet = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          /* ignore */
        }
      };

      const canPrompt = () =>
        !shownThisPage &&
        Date.now() > Number(storageGet(SNOOZE_KEY) || 0) &&
        !storageGet(SUBMITTED_KEY);

      const snooze = () => storageSet(SNOOZE_KEY, String(Date.now() + 7 * 24 * 60 * 60 * 1000));

      function openModal(trigger: string) {
        if (!canPrompt()) return;
        sourceTrigger = trigger || 'manual';
        shownThisPage = true;
        modal!.classList.remove('hidden');
        modal!.classList.add('flex');
        document.body.style.overflow = 'hidden';
        mobileNudge!.classList.add('hidden');
        setTimeout(() => emailInput!.focus({ preventScroll: true }), 120);
      }

      function closeModal() {
        modal!.classList.add('hidden');
        modal!.classList.remove('flex');
        document.body.style.overflow = '';
        snooze();
      }

      document.getElementById('modalClose')!.addEventListener('click', closeModal);
      modal!.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal!.classList.contains('hidden')) closeModal();
      });

      // 首次点击任何联盟跳转链接 → 先展示订阅弹窗 (弹窗内/底栏内的链接放行)
      document.addEventListener(
        'click',
        (e) => {
          const target = e.target as HTMLElement | null;
          const link = target?.closest?.('a');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          if (!href.startsWith(AFFILIATE_PREFIX)) return;
          if (canPrompt() && !link.closest('#dealModal') && !link.closest('#mobileNudge')) {
            e.preventDefault();
            openModal('cta');
            return;
          }
          if (dataLayer) {
            dataLayer.push({
              event: 'affiliate_outbound_click',
              link_url: href,
              trigger: sourceTrigger,
            });
          }
        },
        true
      );

      // 桌面端退出意图: 8 秒后激活, 鼠标从视口顶部离开时触发
      let exitReady = false;
      setTimeout(() => {
        exitReady = true;
      }, 8000);
      document.addEventListener('mouseout', (e) => {
        if (exitReady && e.clientY <= 0 && !e.relatedTarget && canPrompt() && window.innerWidth > 700) {
          openModal('exit');
        }
      });

      // 移动端: 38 秒或滚动 68% 后显示底部提示, 不阻断浏览
      let nudgeShown = false;
      function showNudge() {
        if (nudgeShown || !canPrompt() || window.innerWidth > 700) return;
        nudgeShown = true;
        mobileNudge!.classList.remove('hidden');
        mobileNudge!.classList.add('flex');
      }
      setTimeout(showNudge, 38000);
      window.addEventListener(
        'scroll',
        () => {
          const total = document.documentElement.scrollHeight - window.innerHeight || 1;
          if (window.scrollY / total > 0.68) showNudge();
        },
        { passive: true }
      );
      document.getElementById('nudgeOpen')!.addEventListener('click', () => openModal('nudge'));
      document.getElementById('nudgeClose')!.addEventListener('click', () => {
        mobileNudge!.classList.add('hidden');
        snooze();
      });

      // 邮箱提交 (FormSubmit AJAX)
      form!.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBox!.style.display = 'none';
        errorBox!.textContent = '';
        if (!consent!.checked) {
          errorBox!.textContent = 'Please tick the consent box to subscribe.';
          errorBox!.style.display = 'block';
          return;
        }
        const email = emailInput!.value.trim();
        if (!email) {
          emailInput!.focus();
          return;
        }
        submitBtn!.disabled = true;
        submitBtn!.textContent = 'Sending…';
        const payload = {
          email,
          consent: 'Yes — occasional shopping and promotion emails; unsubscribe on request.',
          source: 'adidas UAE 11.11 landing page',
          prompt_trigger: sourceTrigger,
          submitted_page: window.location.href,
          _subject: 'New adidas UAE 11.11 deal alert opt-in',
          _template: 'table',
          _honey: '',
        };
        let delivered = false;
        for (const endpoint of FORM_ENDPOINTS) {
          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => ({}));
            if (response.ok && (result.success === true || result.success === 'true')) {
              delivered = true;
              break;
            }
          } catch {
            // 当前端点失败 (未激活/网络), 尝试下一个兜底端点
          }
        }
        if (delivered) {
          form!.style.display = 'none';
          successBox!.style.display = 'block';
          storageSet(SUBMITTED_KEY, '1');
          if (dataLayer) {
            dataLayer.push({
              event: 'email_optin_submitted',
              form_name: 'adidas_uae_deal_alerts',
            });
          }
        } else {
          errorBox!.textContent =
            'Sorry, we could not submit your email right now. Please try again in a moment.';
          errorBox!.style.display = 'block';
        }
        submitBtn!.disabled = false;
        submitBtn!.textContent = 'Send me the deals';
      });
    })();
  </script>
</Layout>
