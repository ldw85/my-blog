<!-- ── BEGIN CHECKOUT CONVERSION TRACKING ── -->
<script>
function gtag_report_conversion(url) {
  var callback = function () {
    if (typeof(url) != 'undefined') {
      window.location = url;
    }
  };
  gtag('event', 'conversion', {
      'send_to': 'AW-18013696631/-luUCMfpjZEcEPfkzI1D',
      'value': 0.5,
      'currency': 'CNY',
      'event_callback': callback
  });
  return false;
}
document.querySelectorAll('a.hero-cta-btn, a.sticky-cta-btn, a.final-btn').forEach(function(el) {
  el.addEventListener('click', function() {
    gtag_report_conversion(this.href);
  });
});
</script>

<script>
function toggleFaq(el){ el.classList.toggle('open'); }

(function(){
  var wrap = document.getElementById('stickyWrap');
  var hero = document.getElementById('hero-product');
  if (!wrap || !hero) return;
  new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      wrap.classList.toggle('visible', !e.isIntersecting);
    });
  },{ threshold: 0 }).observe(hero);
})();
</script>

