---
import Layout from '~/layouts/LandingLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

const metadata = {
  title: 'Apple Watch Series 11 Review 2026 - Should You Buy?',
  description: 'Complete Apple Watch Series 11 review with comparison vs Series 10 & Ultra 2. Discover the best deals, key health features, and if upgrading is worth it.',
};
---

<style is:global>
  /* Override intersection animations for Hero section - show immediately */
  .hero-section .intersect-once {
    opacity: 1 !important;
  }
  .hero-section .motion-safe\:md\:opacity-0 {
    opacity: 1 !important;
  }
  .hero-section {
    animation: none !important;
  }
  /* Mid-CTA styling */
  .mid-cta {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  }
  .dark .mid-cta {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  }
  .comparison-table {
    overflow-x: auto;
  }
  .comparison-table table {
    min-width: 600px;
  }
</style>

<Layout metadata={metadata}>
  <!-- Optimized Hero Section -->
  <section class="relative md:-mt-[76px] not-prose hero-section">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">
            Limited Time: 25% Off - Save $100
          </p>
          <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading dark:text-gray-200">
            Apple Watch Series 11 Review
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl text-muted mb-6 dark:text-slate-300">
              Thinner design. Largest display ever. Breakthrough health features. Plus faster charging — get a full day's battery in just 30 minutes.
            </p>
            <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
              <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="btn btn-primary sm:mb-0 amazon-btn">
                <svg class="amazon-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.12.221-.06.385-.03.533.09.146.124.19.3.13.53-.06.23-.193.385-.404.466-.673.27-1.42.404-2.242.404-2.35 0-4.577-.782-6.683-2.347-2.105-1.565-3.164-3.542-3.178-5.928-.016-2.32.923-4.334 2.816-6.04 1.893-1.706 4.272-2.56 7.137-2.56 2.536 0 4.79.654 6.762 1.96 1.973 1.307 3.352 3.12 4.138 5.44.067.2.103.415.103.646 0 .327-.093.63-.28.91-.186.278-.445.417-.776.417-.24 0-.52-.088-.84-.265a3.44 3.44 0 01-.96-.765 10.204 10.204 0 01-.96-1.235c-1.04-1.357-2.283-2.42-3.727-3.186-1.444-.767-3.097-1.15-4.958-1.15-2.578 0-4.843.628-6.795 1.886-1.95 1.256-3.352 2.98-4.206 5.168-.854 2.187-1.03 4.483-.53 6.885zm9.12-3.602c-1.073.79-2.48 1.185-4.22 1.185-1.353 0-2.555-.314-3.604-.944-1.05-.63-1.82-1.485-2.31-2.566-.49-1.08-.657-2.256-.502-3.525.17-1.385.703-2.593 1.6-3.622.896-1.03 2.055-1.78 3.477-2.25 1.42-.47 2.982-.643 4.683-.52.846.062 1.627.196 2.343.404.716.207 1.332.502 1.848.884.073.06.134.126.183.197.05.07.087.145.112.224.025.08.037.16.037.24 0 .17-.062.317-.186.442-.124.125-.285.187-.483.187-.255 0-.567-.117-.937-.352-.37-.234-.773-.53-1.21-.886-1.24-1.01-2.65-1.516-4.23-1.516-1.795 0-3.346.616-4.653 1.848-1.307 1.233-1.98 2.826-2.016 4.78-.036 1.763.488 3.258 1.57 4.484 1.082 1.227 2.514 1.876 4.296 1.948.856.034 1.64-.022 2.353-.168.713-.147 1.3-.368 1.762-.664v-3.204c-.337.226-.73.403-1.178.53-.447.128-.94.192-1.477.192-.838 0-1.555-.178-2.152-.533-.597-.356-.96-.812-1.09-1.37h6.374z"/></svg>
                Check Current Discount on Amazon
              </a>
              <a href="#comparison" class="btn btn-secondary sm:mb-0">
                View Comparison
              </a>
            </div>
            <!-- Scarcity Message -->
            <p class="mt-4 text-sm text-orange-600 dark:text-orange-400 font-medium">
              ⚡ Limited inventory — Space Gray 46mm is running low today
            </p>
          </div>
        </div>
        <div class="relative m-auto max-w-5xl">
          <img 
            src="https://m.media-amazon.com/images/G/01/apple/Apple_Watch_Series_11_Product_Page_L__en-US_01._CB800260814_.jpg" 
            alt="Apple Watch Series 11"
            class="mx-auto rounded-md w-full"
            loading="eager"
            width="1024"
            height="576"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <Stats
    title=""
    items={[
      { title: 'Display Size', amount: '40%', description: 'larger than Series 6' },
      { title: 'Charging Speed', amount: '45', description: 'min to 80%' },
      { title: 'Battery Life', amount: '18-36', description: 'hours' },
      { title: 'Water Resistance', amount: '50m', description: 'swim-proof' },
    ]}
  />

  <!-- Quick Choice Table - Should You Upgrade? -->
  <section class="py-12 md:py-16 bg-gradient-to-b from-primary/5 to-transparent">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold mb-2">Should You Upgrade?</h2>
        <p class="text-muted"> Honest recommendations based on your current watch</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Series 9 or older -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-lg border-2 border-green-500 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full">
            RECOMMENDED
          </div>
          <h3 class="text-lg font-bold mb-3">Series 9 or Older</h3>
          <p class="text-muted text-sm mb-4">Major leap in display, charging speed, and health sensors</p>
          <ul class="space-y-2 text-sm mb-4">
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> 40% larger display</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> 2x faster charging</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> New temperature sensor</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> Skin temp tracking</li>
          </ul>
          <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-sm">
            Upgrade Now →
          </a>
        </div>
        
        <!-- Series 10 -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-lg border-2 border-yellow-500 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-yellow-500 text-white text-xs font-bold px-3 py-1 rounded-full">
            CONSIDER
          </div>
          <h3 class="text-lg font-bold mb-3">Series 10</h3>
          <p class="text-muted text-sm mb-4">Only upgrade if you need these specific features</p>
          <ul class="space-y-2 text-sm mb-4">
            <li class="flex items-start gap-2"><span class="text-yellow-500">•</span> Temperature sensing</li>
            <li class="flex items-start gap-2"><span class="text-yellow-500">•</span> Slightly thinner</li>
            <li class="flex items-start gap-2"><span class="text-gray-400">✗</span> Similar battery life</li>
            <li class="flex items-start gap-2"><span class="text-gray-400">✗</span> Same processor speed</li>
          </ul>
          <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-yellow-600 hover:bg-yellow-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-sm">
            Check Deals →
          </a>
        </div>
        
        <!-- First Gen / SE -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-lg border-2 border-green-500 relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full">
            HIGHLY RECOMMENDED
          </div>
          <h3 class="text-lg font-bold mb-3">Series 6 or Older</h3>
          <p class="text-muted text-sm mb-4">Transformative upgrade — you'll notice every difference</p>
          <ul class="space-y-2 text-sm mb-4">
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> All new features</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> Battery optimization</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> Always-On display</li>
            <li class="flex items-start gap-2"><span class="text-green-500">✓</span> 5G Cellular option</li>
          </ul>
          <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="block w-full text-center bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors text-sm">
            Get Series 11 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits -->
  <Features
    title="Why Apple Watch Series 11 Is Worth It"
    subtitle="More than features — these are the real benefits that matter in your daily life"
    items={[
      {
        title: 'Know If Your Heart Is Healthy — While You Sleep',
        description: 'Continuous ECG monitoring detects irregular heart rhythms early. Get alerts before symptoms appear, giving you peace of mind 24/7.',
      },
      {
        title: 'Never Miss a Message — Even in Bright Sunlight',
        description: 'The brightest Always-On Retina display (2000 nits) means you can read notifications at the beach, on the trail, or anywhere without raising your wrist.',
      },
      {
        title: 'Get a Full Day\'s Battery in 30 Minutes',
        description: 'Fast charging means you\'re never tied to an outlet. A morning coffee is enough to keep your watch running all day.',
      },
      {
        title: 'Understand Your Sleep Quality — Finally',
        description: 'New skin temperature sensors track overnight trends and provide insights into your sleep patterns. Wake up knowing how well you actually rested.',
      },
      {
        title: 'Close Your Rings, Every Single Day',
        description: 'The three-ring system makes staying active feel like a game. Compete with friends, earn badges, and build lasting healthy habits.',
      },
      {
        title: 'Swim, Surf, and Dive — No Worries',
        description: '50m water resistance means the ocean is your gym. Track your lap times, monitor heart rate underwater, and rinse off when you\'re done.',
      },
    ]}
  />

  <!-- Mid-Page CTA -->
  <section class="mid-cta py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-lg font-semibold text-primary mb-2">🔥 Today's Best Deal</p>
      <h3 class="text-2xl md:text-3xl font-bold mb-4">Save $100 on Apple Watch Series 11</h3>
      <p class="text-muted mb-6">Check the current discount on Amazon — deals change daily.</p>
      <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="btn btn-primary amazon-btn inline-flex items-center gap-2">
        <svg class="amazon-icon w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.12.221-.06.385-.03.533.09.146.124.19.3.13.53-.06.23-.193.385-.404.466-.673.27-1.42.404-2.242.404-2.35 0-4.577-.782-6.683-2.347-2.105-1.565-3.164-3.542-3.178-5.928-.016-2.32.923-4.334 2.816-6.04 1.893-1.706 4.272-2.56 7.137-2.56 2.536 0 4.79.654 6.762 1.96 1.973 1.307 3.352 3.12 4.138 5.44.067.2.103.415.103.646 0 .327-.093.63-.28.91-.186.278-.445.417-.776.417-.24 0-.52-.088-.84-.265a3.44 3.44 0 01-.96-.765 10.204 10.204 0 01-.96-1.235c-1.04-1.357-2.283-2.42-3.727-3.186-1.444-.767-3.097-1.15-4.958-1.15-2.578 0-4.843.628-6.795 1.886-1.95 1.256-3.352 2.98-4.206 5.168-.854 2.187-1.03 4.483-.53 6.885zm9.12-3.602c-1.073.79-2.48 1.185-4.22 1.185-1.353 0-2.555-.314-3.604-.944-1.05-.63-1.82-1.485-2.31-2.566-.49-1.08-.657-2.256-.502-3.525.17-1.385.703-2.593 1.6-3.622.896-1.03 2.055-1.78 3.477-2.25 1.42-.47 2.982-.643 4.683-.52.846.062 1.627.196 2.343.404.716.207 1.332.502 1.848.884.073.06.134.126.183.197.05.07.087.145.112.224.025.08.037.16.037.24 0 .17-.062.317-.186.442-.124.125-.285.187-.483.187-.255 0-.567-.117-.937-.352-.37-.234-.773-.53-1.21-.886-1.24-1.01-2.65-1.516-4.23-1.516-1.795 0-3.346.616-4.653 1.848-1.307 1.233-1.98 2.826-2.016 4.78-.036 1.763.488 3.258 1.57 4.484 1.082 1.227 2.514 1.876 4.296 1.948.856.034 1.64-.022 2.353-.168.713-.147 1.3-.368 1.762-.664v-3.204c-.337.226-.73.403-1.178.53-.447.128-.94.192-1.477.192-.838 0-1.555-.178-2.152-.533-.597-.356-.96-.812-1.09-1.37h6.374z"/></svg>
        Check Current Discount on Amazon (Save $100) →
      </a>
      <p class="mt-3 text-sm text-orange-600 dark:text-orange-400">
        ⚡ Space Gray 46mm is running low today
      </p>
    </div>
  </section>

  <!-- Comparison Table Section -->
  <section id="comparison" class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Series 11 vs Series 10 vs Ultra 2</h2>
        <p class="text-xl text-muted max-w-2xl mx-auto">Not sure which Apple Watch is right for you? Here's the honest comparison to help you decide.</p>
      </div>
      
      <div class="comparison-table">
        <table class="w-full border-collapse bg-white dark:bg-slate-800 rounded-lg overflow-hidden shadow-lg">
          <thead>
            <tr class="bg-primary text-white">
              <th class="p-4 text-left font-semibold">Feature</th>
              <th class="p-4 text-center font-semibold bg-green-600">Series 11 ⭐</th>
              <th class="p-4 text-center font-semibold">Series 10</th>
              <th class="p-4 text-center font-semibold">Ultra 2</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            <tr>
              <td class="p-4 font-medium">Display Size</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">46mm (largest)</td>
              <td class="p-4 text-center">45mm</td>
              <td class="p-4 text-center">49mm</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Thickness</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">9.7mm (thinnest)</td>
              <td class="p-4 text-center">10.1mm</td>
              <td class="p-4 text-center">14.4mm</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Battery Life</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">18-36 hrs</td>
              <td class="p-4 text-center">18-36 hrs</td>
              <td class="p-4 text-center">36-72 hrs</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Fast Charging</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">✅ 0-80% in 45min</td>
              <td class="p-4 text-center">✅ 0-80% in 45min</td>
              <td class="p-4 text-center">❌ No</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Blood Oxygen Sensor</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">✅ Yes</td>
              <td class="p-4 text-center">✅ Yes</td>
              <td class="p-4 text-center">✅ Yes</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">ECG App</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">✅ Yes</td>
              <td class="p-4 text-center">✅ Yes</td>
              <td class="p-4 text-center">✅ Yes</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Skin Temperature</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">✅ Yes</td>
              <td class="p-4 text-center">❌ No</td>
              <td class="p-4 text-center">❌ No</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Water Resistance</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">50m</td>
              <td class="p-4 text-center">50m</td>
              <td class="p-4 text-center">100m</td>
            </tr>
            <tr>
              <td class="p-4 font-medium">Price (Aluminum)</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold text-green-600 dark:text-green-400">From $299</td>
              <td class="p-4 text-center">From $399</td>
              <td class="p-4 text-center">From $799</td>
            </tr>
            <tr class="bg-gray-50 dark:bg-slate-700/50">
              <td class="p-4 font-bold">Best For</td>
              <td class="p-4 text-center bg-green-50 dark:bg-green-900/20 font-semibold">Most people — best value</td>
              <td class="p-4 text-center">Upgraders from Series 7/8</td>
              <td class="p-4 text-center">Athletes, adventurers</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <div class="text-center mt-8">
        <p class="text-muted mb-4">Series 11 offers the newest features at the best price point.</p>
        <a href="https://amzn.to/4b5SjD3" target="_blank" rel="noopener noreferrer" class="btn btn-primary amazon-btn inline-flex items-center gap-2">
          <svg class="amazon-icon w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.12.221-.06.385-.03.533.09.146.124.19.3.13.53-.06.23-.193.385-.404.466-.673.27-1.42.404-2.242.404-2.35 0-4.577-.782-6.683-2.347-2.105-1.565-3.164-3.542-3.178-5.928-.016-2.32.923-4.334 2.816-6.04 1.893-1.706 4.272-2.56 7.137-2.56 2.536 0 4.79.654 6.762 1.96 1.973 1.307 3.352 3.12 4.138 5.44.067.2.103.415.103.646 0 .327-.093.63-.28.91-.186.278-.445.417-.776.417-.24 0-.52-.088-.84-.265a3.44 3.44 0 01-.96-.765 10.204 10.204 0 01-.96-1.235c-1.04-1.357-2.283-2.42-3.727-3.186-1.444-.767-3.097-1.15-4.958-1.15-2.578 0-4.843.628-6.795 1.886-1.95 1.256-3.352 2.98-4.206 5.168-.854 2.187-1.03 4.483-.53 6.885zm9.12-3.602c-1.073.79-2.48 1.185-4.22 1.185-1.353 0-2.555-.314-3.604-.944-1.05-.63-1.82-1.485-2.31-2.566-.49-1.08-.657-2.256-.502-3.525.17-1.385.703-2.593 1.6-3.622.896-1.03 2.055-1.78 3.477-2.25 1.42-.47 2.982-.643 4.683-.52.846.062 1.627.196 2.343.404.716.207 1.332.502 1.848.884.073.06.134.126.183.197.05.07.087.145.112.224.025.08.037.16.037.24 0 .17-.062.317-.186.442-.124.125-.285.187-.483.187-.255 0-.567-.117-.937-.352-.37-.234-.773-.53-1.21-.886-1.24-1.01-2.65-1.516-4.23-1.516-1.795 0-3.346.616-4.653 1.848-1.307 1.233-1.98 2.826-2.016 4.78-.036 1.763.488 3.258 1.57 4.484 1.082 1.227 2.514 1.876 4.296 1.948.856.034 1.64-.022 2.353-.168.713-.147 1.3-.368 1.762-.664v-3.204c-.337.226-.73.403-1.178.53-.447.128-.94.192-1.477.192-.838 0-1.555-.178-2.152-.533-.597-.356-.96-.812-1.09-1.37h6.374z"/></svg>
          Check Current Discount (Save $100) →
        </a>
      </div>
    </div>
  </section>

  <!-- Health Features Deep Dive -->
  <Content
    title="Your Personal Health Guardian"
    subtitle="Advanced sensors that watch over you around the clock"
    items={[
      {
        title: 'ECG — Catch Heart Issues Before They Become Problems',
        description: 'Take an electrocardiogram in 30 seconds. Detects atrial fibrillation, the most common heart arrhythmia. Early detection saves lives.',
      },
      {
        title: 'Blood Oxygen — Monitor Respiratory Health 24/7',
        description: 'Track blood oxygen levels during workouts and sleep. Athletes use it to optimize training. Everyone else uses it for peace of mind.',
      },
      {
        title: 'Sleep Tracking — Finally Understand Your Rest',
        description: 'Detailed nightly analysis shows REM, Core, and Deep sleep stages. Wake up to personalized insights that help you actually improve your rest.',
      },
      {
        title: 'Temperature Sensing — New in Series 11',
        description: 'Tracks skin temperature overnight, providing insights for cycle tracking and wellness. Know your body better, day by day.',
      },
    ]}
