  },
  {
    name: "Series 10",
    price: "From $399",
    display: "45mm",
    thickness: "10.1mm",
    battery: "18–36 hrs",
    fastCharge: "✅ 0–80% in 45min",
    skinTemp: "❌ No",
    water: "50m",
    bestFor: "Upgraders from Series 7/8",
    recommend: "CONSIDER",
    recColor: "yellow",
    link: "https://amzn.to/4b5SjD3",
  },
  {
    name: "Ultra 2",
    price: "From $799",
    display: "49mm",
    thickness: "14.4mm",
    battery: "36–72 hrs",
    fastCharge: "❌ No",
    skinTemp: "❌ No",
    water: "100m",
