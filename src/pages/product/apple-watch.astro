  reviewStars: 5,
};

const comparisonProducts = [
  {
    name: "Series 11 ⭐",
    price: "From $299",
    display: "46mm (largest)",
    thickness: "9.7mm (thinnest)",
    battery: "18–36 hrs",
    fastCharge: "✅ 0–80% in 45min",
