---
const metadata = {
  title: 'Apple Watch Series 11 Review 2026 — Save $100 | TechRuling',
  description: 'Apple Watch Series 11 review: 40% larger display, fast charging, skin temperature sensing. Save 25% off on Amazon. Honest comparison vs Series 10 & Ultra 2.',
};

const heroProduct = {
  name: "Apple Watch Series 11 (45mm)",
  price: "From $299",
  originalPrice: "From $399",
  rating: 4.8,
  reviewCount: "12,400+",
  image: "https://m.media-amazon.com/images/G/01/apple/Apple_Watch_Series_11_Product_Page_L__en-US_01._CB800260814_.jpg",
  affiliateLink: "https://amzn.to/4b5SjD3",
  discount: "Save $100 (25% off)",
  scarcity: "⚡ Space Gray 46mm is running low today",
  badge: "🏆 Best Value Pick",
  benefits: [
    "40% larger display — biggest Apple Watch screen ever",
    "Fast charging: 0–80% in just 45 minutes",
