    shortName: "Classic Retro Mary Jane",
    price: "$41.99",
    originalPrice: "$44.99",
    rating: 4.5,
    reviewCount: 2847,
    image: "https://m.media-amazon.com/images/S/aplus-media-library-service-media/b4b1c1e9-7b1c-495b-9aeb-02aa13c355c9.__CR0,0,1464,600_PT0_SX1464_V1___.jpg",
    images: [
      "https://m.media-amazon.com/images/S/aplus-media-library-service-media/b4b1c1e9-7b1c-495b-9aeb-02aa13c355c9.__CR0,0,1464,600_PT0_SX1464_V1___.jpg",
      "https://m.media-amazon.com/images/I/616Rx2xfUTL._AC_UF480,480_SR480,480_.jpg"
    ],
    affiliateLink: "https://amzn.to/4bKZqjC",
    tagline: "Premium leather, adjustable strap, non-slip sole",
    benefit: "Best Classic Mary Jane Look",
    review: {
      title: "Perfect Everyday Shoe",
      text: "Oh, these are so, so cute! I wear a 6.5, ordered such, and length-wise, a perfect fit. They seemed to be well-made, and were very comfy!",
      author: "Verified Amazon Buyer",
      stars: 5
    },
    highlights: [
      "Premium synthetic leather — water-resistant",
      "Non-slip rubber outsole with textured grip",
      "Adjustable strap for customized fit",
      "Pairs with jeans, shorts, dresses, skirts"
    ]
  },
  {
    id: 2,
    name: "WHITIN Women's Barefoot Mary Jane Flats",
    shortName: "Barefoot Comfort Flats",
    price: "$44.95",
    originalPrice: "$59.95",
    rating: 4.6,
    reviewCount: 1923,
    image: "https://images-na.ssl-images-amazon.com/images/I/81VLuzYwGAL._AC_UL330_SR330,330_.jpg",
    images: [
      "https://images-na.ssl-images-amazon.com/images/I/81VLuzYwGAL._AC_UL330_SR330,330_.jpg",
      "https://m.media-amazon.com/images/I/81hx5TIXkzL._AC_UF480,480_SR480,480_.jpg"
    ],
    affiliateLink: "https://amzn.to/4bCE2yj",
    tagline: "Wide toe box + zero drop sole",
    benefit: "Best for Wide Feet & Barefoot Feel",
